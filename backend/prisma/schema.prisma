generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@cims/prisma-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  ENGINEER
  LAB_TECH
  BILLING_OFFICER
}

enum AppointmentStatus {
  SCHEDULED
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  IN_PROGRESS
  FINALIZED
}

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  ANALYZING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model User {
  id             String         @id @default(cuid())
  username       String?        @unique
  email          String         @unique
  password       String         @default("cims123")
  name           String
  role           Role           @default(DOCTOR)
  department     String?
  licenseNumber  String?
  phone          String?
  avatar         String?
  permissions    String         @default("[]")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  doctorAppointments Appointment[] @relation("DoctorAppointments")
  doctorEncounters   Encounter[]   @relation("DoctorEncounters")
  prescriptions      Prescription[] @relation("DoctorPrescriptions")
  labOrders          LabOrder[]     @relation("DoctorLabOrders")
  auditLogs          AuditLog[]
  notificationReads  NotificationRead[]
}

model Patient {
  id                       String         @id @default(cuid())
  mrn                      String         @unique // Medical Record Number e.g. CIMS-2026-0001
  title                    String?
  firstName                String
  lastName                 String
  fatherHusbandName        String?
  gender                   String         // Male, Female, Other
  dateOfBirth              DateTime
  ageValue                 Int?
  ageUnit                  String?
  bloodGroup               String?        // A+, A-, B+, B-, AB+, AB-, O+, O-
  phone                    String
  email                    String?
  nationalId               String?
  address                  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  allergies                String?        @ignore // Retired field; preserve legacy database values only.
  chronicConditions        String?        // JSON or comma-delimited string
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  appointments             Appointment[]
  encounters               Encounter[]
  vitals                   Vitals[]
  prescriptions            Prescription[]
  labOrders                LabOrder[]
  invoices                 Invoice[]
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  department     String            @default("General Medicine")
  scheduledAt    DateTime
  checkedInAt    DateTime?
  tokenNumber    Int
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  type           String            @default("OPD") // OPD, Follow-up, Emergency
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  encounter      Encounter?
}

model Encounter {
  id                     String          @id @default(cuid())
  patientId              String
  patient                Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId               String
  doctor                 User            @relation("DoctorEncounters", fields: [doctorId], references: [id])
  appointmentId          String?         @unique
  appointment            Appointment?    @relation(fields: [appointmentId], references: [id])
  encounterDate          DateTime        @default(now())
  status                 EncounterStatus @default(IN_PROGRESS)
  
  // Clinical SOAP note sections
  chiefComplaint         String?
  hpi                    String?         // History of Present Illness
  physicalExam           String?         // Objective physical exam
  assessmentPlan         String?         // Clinical assessment and therapeutic plan
  clinicalNotes          String?         // Additional clinical instructions
  followUpDate           DateTime?
  draftData              String?         // Unissued diagnosis and prescription draft.
  revision               Int             @default(0)
  
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  vitals                 Vitals[]
  diagnoses              Diagnosis[]
  prescriptions          Prescription[]
  labOrders              LabOrder[]
  invoices               Invoice[]
}

model Vitals {
  id               String      @id @default(cuid())
  patientId        String
  patient          Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId      String?
  encounter        Encounter?  @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedAt       DateTime    @default(now())
  systolicBP       Int?        // mmHg
  diastolicBP      Int?        // mmHg
  heartRate        Int?        // bpm
  temperature      Float?      // °C
  respiratoryRate  Int?        // breaths/min
  spO2             Int?        // %
  weightKg         Float?
  heightCm         Float?
  bmi              Float?
  bloodGlucose     Float?      // mg/dL
  painScore        Int?        // 0-10
  notes            String?
  recordedBy       String?     // Nurse / Clinician name
}

model Diagnosis {
  id             String      @id @default(cuid())
  encounterId    String
  encounter      Encounter   @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icdCode        String      // e.g. J06.9
  description    String      // e.g. Acute upper respiratory infection
  type           String      @default("PROVISIONAL") // PROVISIONAL, FINAL
  notes          String?
  createdAt      DateTime    @default(now())
}

model Prescription {
  id             String             @id @default(cuid())
  encounterId    String
  encounter      Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  status         PrescriptionStatus @default(PENDING)
  dispensedAt    DateTime?
  dispensedBy    String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items          PrescriptionItem[]
}

model PrescriptionItem {
  id               String       @id @default(cuid())
  prescriptionId   String
  prescription     Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationName   String
  genericName      String?
  dosage           String       // e.g. 500mg
  route            String       @default("Oral") // Oral, IV, IM, Topical, Inhalation
  frequency        String       // e.g. 1-0-1, TDS (3 times daily), PRN
  duration         String       // e.g. 5 days, 1 month
  quantity         Int          @default(1)
  instructions     String?      // e.g. After meals
  isDispensed      Boolean      @default(false)
}

model Medication {
  id               String       @id @default(cuid())
  brandName        String
  genericName      String
  form             String       // Tablet, Capsule, Syrup, Injection, Inhaler, Drops
  strength         String       // 500mg, 10mg/ml, etc.
  stockUnit        String       @default("PIECE") // PIECE, PILL_PACK, SYRUP_BOTTLE, BOTTLE
  stockQuantity    Int          @default(0)
  minStockLevel    Int          @default(10)
  unitPrice        Float        @default(0.0)
  batchNumber      String?
  expiryDate       DateTime?
  manufacturer     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  saleItems        PharmacySaleItem[]
  stockMovements   PharmacyStockMovement[]
}

model PharmacySale {
  id               String       @id @default(cuid())
  saleNumber       String       @unique
  customerName     String?
  soldBy           String
  paymentMethod    String       @default("Cash")
  totalAmount      Float
  notes            String?
  createdAt        DateTime     @default(now())

  items            PharmacySaleItem[]
}

model PharmacySaleItem {
  id               String       @id @default(cuid())
  saleId           String
  sale             PharmacySale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicationId     String
  medication       Medication   @relation(fields: [medicationId], references: [id])
  medicationName   String
  quantity         Int
  unit             String       @default("PIECE")
  unitPrice        Float
  totalPrice       Float
}

model PharmacyStockMovement {
  id               String       @id @default(cuid())
  medicationId     String
  medication       Medication   @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  type             String
  quantity         Int
  unit             String       @default("PIECE")
  balanceAfter     Int
  reference        String?
  recordedBy       String
  createdAt        DateTime     @default(now())
}

model LabTestCatalog {
  id               String       @id @default(cuid())
  testCode         String       @unique // e.g. CBC-001, LFT-002
  testName         String
  category         String       // Hematology, Biochemistry, Microbiology, Serology, Radiology
  sampleType       String?      // Blood, Urine, Serum, Sputum
  price            Float        @default(0.0)
  normalRange      String?      // Normal reference values description or JSON
  turnaroundTime   String?      // e.g. 2 hours, 24 hours
  createdAt        DateTime     @default(now())
}

model LabOrder {
  id                 String         @id @default(cuid())
  orderNumber        String         @unique // e.g. LAB-2026-0001
  patientId          String
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             User           @relation("DoctorLabOrders", fields: [doctorId], references: [id])
  encounterId        String?
  encounter          Encounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  status             LabOrderStatus @default(ORDERED)
  priority           String         @default("ROUTINE") // ROUTINE, URGENT, STAT
  orderedAt          DateTime       @default(now())
  sampleCollectedAt  DateTime?
  completedAt        DateTime?
  technicianNotes    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  items              LabOrderItem[]
}

model LabOrderItem {
  id                 String       @id @default(cuid())
  labOrderId         String
  labOrder           LabOrder     @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  testName           String
  category           String?
  status             String       @default("PENDING") // PENDING, COMPLETED
  resultValue        String?
  unit               String?
  referenceRange     String?
  isAbnormal         Boolean      @default(false)
  notes              String?
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique // e.g. INV-2026-0001
  patientId          String
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId        String?
  encounter          Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  subtotal           Float         @default(0.0)
  discount           Float         @default(0.0)
  tax                Float         @default(0.0)
  totalAmount        Float         @default(0.0)
  paidAmount         Float         @default(0.0)
  balanceDue         Float         @default(0.0)
  status             InvoiceStatus @default(UNPAID)
  paymentMethod      String?       // Cash, Credit Card, Insurance, Mobile Banking
  issuedAt           DateTime      @default(now())
  paidAt             DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items              InvoiceItem[]
  payments           Payment[]
}

model InvoiceItem {
  id                 String        @id @default(cuid())
  invoiceId          String
  invoice            Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description        String
  category           String        // CONSULTATION, LAB_TEST, PHARMACY, PROCEDURE, SERVICE
  quantity           Int           @default(1)
  unitPrice          Float         @default(0.0)
  totalPrice         Float         @default(0.0)
}

model Payment {
  id                 String        @id @default(cuid())
  invoiceId          String
  invoice            Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount             Float
  method             String
  reference          String?
  receivedBy         String?
  notes              String?
  receivedAt         DateTime      @default(now())

  @@index([invoiceId, receivedAt])
  @@index([receivedAt])
}

model AuditLog {
  id                 String        @id @default(cuid())
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName           String?
  userRole           String?
  action             String        // CREATE, READ, UPDATE, DELETE, DISPENSE, FINALIZE, EXPORT
  resource           String        // PATIENT, ENCOUNTER, PRESCRIPTION, LAB_ORDER, INVOICE, AUTH
  resourceId         String?
  details            String?
  ipAddress          String?
  timestamp          DateTime      @default(now())
}

model Notification {
  id                 String             @id @default(cuid())
  type               String             @default("PATIENT_TICKET")
  audience           String             @default("QUEUE")
  title              String
  message            String
  href               String?
  appointmentId      String?
  createdAt          DateTime           @default(now())
  reads              NotificationRead[]

  @@index([createdAt])
  @@index([audience, createdAt])
  @@index([appointmentId])
}

model NotificationRead {
  id                 String       @id @default(cuid())
  notificationId     String
  notification       Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt             DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model SecurityAlert {
  id                 String       @id @default(cuid())
  username           String
  ipAddress          String       @default("unknown")
  failedCount        Int          @default(1)
  isRead             Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([username, ipAddress])
  @@index([isRead, updatedAt])
}
