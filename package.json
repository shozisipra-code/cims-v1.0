{
  "name": "cims-clinic",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --workspace cims-frontend run dev",
    "dev:backend": "npm --workspace cims-backend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm --workspace cims-frontend run build",
    "build:backend": "npm --workspace cims-backend run build",
    "db:push": "npm --workspace cims-backend run db:push",
    "db:generate": "npm --workspace cims-backend run db:generate",
    "db:seed": "npm --workspace cims-backend run db:seed",
    "db:studio": "npm --workspace cims-backend run db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
